FROM python:3.11-slim-bookworm
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/result_to_draw
COPY requirements-runtime.txt ./
RUN pip install --no-cache-dir -r requirements-runtime.txt
COPY scripts/model_core.py scripts/feature_engineering.py ./
COPY service/app.py ./app.py
COPY assets ./assets
RUN useradd --uid 10001 --no-create-home appuser && mkdir /data && chown 10001:10001 /data
USER 10001:10001
ENV PYTHONPATH=/opt/result_to_draw MODEL_ASSETS=/opt/result_to_draw/assets RESULTS_DB=/data/result_to_draw.sqlite
EXPOSE 8788
CMD ["python", "-m", "uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8788", "--workers", "1"]
